# Duolingo Gold 解锁 —— Anywhere MITM 规则集(.amrs,CN→COM 网关实验)
# 订阅前提:URL 路径必须以 .amrs 结尾;HTTP 2xx + UTF-8 正文。
# 文档:https://github.com/NodePassProject/Anywhere/blob/main/Documentations/MITM.md
# Duolingo Gold 解锁 —— Anywhere MITM 规则集(由 build_anywhere.py 生成,勿手改规则行)
name = Duolingo Gold 解锁
hostname = duolingo.com, duolingo.cn
# 说明:Anywhere 的 hostname 是后缀精确匹配、无通配符;原 Loon 的 4 条通配主机
#      (`ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn`)
#      已折叠为上面的 eTLD 后缀,具体主机范围由下方 url-pattern 正则收敛。

# ===== CN→COM 网关改写(实验)=====
# 实测 ios-api-2.duolingo.cn 的 ALPN 只给 http/1.1:上游恒为 h1.1 → 大响应只能
#   用 Content-Length + 4 MiB 缓冲,11.6 MB 的 /batch 天生改不了。
#   *.duolingo.com 给 h2 → 引擎走 MITMHTTP2UpstreamLeg,流式脚本逐帧改写,无 4 MiB 限制。
#   透明改写(dial 目标 + Host/:authority 一起换),客户端看到的仍是原主机名。
# 本规则会改变后端(from .cn 到 .com)。若出现 401/403/502 或登录异常,
#   说明账号/后端是分区的 —— 立刻删掉本模块,别留着。
0, 0, ^https?://([a-z0-9-]+)\.duolingo\.cn(/.*)?$, 0, https://$1.duolingo.com$2

# 请求阶段:去掉条件请求头,避免上游回 304 / 带 etag 的子响应把注入短路掉
0, 2, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/, if-none-match
0, 2, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/, if-modified-since

# /batch:解压后 >4 MiB 撞 buffered 解码上限(日志 `decompress output would exceed cap`),
#   所以必须要求上游不压缩(stream-script 本身也不做解压)。
#   先 2(headerDelete)再 1(headerAdd):headerReplace 只改「已存在」的头(见
#   MITMHTTP1Stream.applyHeaderRules / MITMHTTP2Rewriter.apply...HeaderRules),
#   客户端没带 Accept-Encoding 时它是空操作 → 响应仍是 br → 解码照样撞上限。
#   两条规则按文件顺序执行,delete+add 保证线上恰好一个 `Accept-Encoding: identity`。
0, 2, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/batch(?:[?#]|$), Accept-Encoding
0, 1, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/batch(?:[?#]|$), Accept-Encoding, identity

# 请求方向诊断(phase 0 + op 100):把引擎那几条「不带 URL」的告警对应到具体端点,
#   并现场证明 accept-encoding 改写是否上线(ctx.headers 是改写后的头)。
#   只读只记,不改请求体、不 done()。不需要时可以整行删掉。
0, 100, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/(?:batch|users/[^/?#]+)(?:[?#]|$), 
1, 101, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/batch(?:[?#]|$), 

# 兜底 + 单对象小响应:buffered script(100),base64 解出 function process(ctx)
#   引擎按 framing 二选一:h2 DATA / h1.1 chunked 走上面的 101,h1.1 + Content-Length
#   走这条(此时 101 会被跳过,见 MITMHTTP1Stream.enterContentLength)。
#   注意 Content-Length 超过 4 MiB 时引擎会直接放行(日志「超出 cap」),
#   那种情况两种脚本都改不了。
1, 100, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/(?:batch|users/[^/?#]+)(?:[?#]|$), 

# ===== 实机探测(v2.12)确认的「会员状态真源头」=====
# 这两条比 /batch 小几个数量级,却是 SDUI / 订阅页真正读的地方:
#   subscription-catalog  → plusPackageViewModels + subscriptionFeatureGroupId(2 KB)
#   available-features    → subscriptionFeatures(164 B)
# 它们都在 users/<id>/ 之下,会被上面的 BUFFERED_PATTERN 收进去;
#   这里显式再列一条「更具体的」规则只是为了让意图可读(引擎按序试规则,
#   先命中的生效) —— 真正的注入逻辑仍由同一个 buffered 脚本按 JSON 形状判定。
1, 100, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/users/[^/?#]+/subscription-catalog(?:[?#]|$), 
1, 100, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/2023-05-23/users/[^/?#]+/available-features(?:[?#]|$), 

[Parameter]
# type, data-type, name, label, description, default, [options]
1, 0, debug, 调试日志, "开启后在 Anywhere 日志里输出注入结果,便于排查。", 0, "[0, 1]"
1, 0, shape, 形状保守, "1 = 只修改客户端通过 fields= 明确要了的字段,绝不新增。0 = 按完整 userdata 形状注入(默认)。若某端点响应异常小却被注成很大,可试 1。", 0, "[0, 1]"
1, 0, holdMB, 持有上限(MB), "流式脚本在定位 userdata 子响应前最多持有多少正文,也就是它自己的内存上限。实测大响应约 12 MB;调小可省内存,调大才能改写更大的响应。", 14, "[4, 8, 14, 20]"
