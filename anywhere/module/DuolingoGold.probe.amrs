# Duolingo Gold 解锁 —— Anywhere MITM 规则集(.amrs,会员探测/只读)
# 订阅前提:URL 路径必须以 .amrs 结尾;HTTP 2xx + UTF-8 正文。
# 文档:https://github.com/NodePassProject/Anywhere/blob/main/Documentations/MITM.md
# Duolingo 会员数据探测 —— Anywhere MITM 规则集(只读,由 build_anywhere.py 生成)
name = Duolingo Gold 解锁(会员探测)
hostname = duolingo.com, duolingo.cn
# 用途:把每个 duolingo API 响应的 URL / 状态 / 字节数 / 会员键路径打进日志,
#   用来定位会员字段的真实位置(哪个端点、哪层嵌套、是否在 responses[i].body 字符串里)。
# 本规则集**不改任何响应**;不删条件请求头,304 也是有效信号。

# 探测脚本不做解压,所以必须要求上游别压缩(否则只能看到 json=NO)
0, 2, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/, Accept-Encoding
0, 1, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/, Accept-Encoding, identity

1, 100, ^https?://(?:ios-api-[a-z0-9-]+|api[a-z0-9-]*)\.duolingo\.c(?:n|om)/, 

[Parameter]
# type, data-type, name, label, description, default, [options]
1, 0, debug, 调试日志, "开启后在 Anywhere 日志里输出注入结果,便于排查。", 0, "[0, 1]"
1, 0, shape, 形状保守, "1 = 只修改客户端通过 fields= 明确要了的字段,绝不新增。0 = 按完整 userdata 形状注入(默认)。若某端点响应异常小却被注成很大,可试 1。", 0, "[0, 1]"
