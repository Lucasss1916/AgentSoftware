#!name=Duolingo Max 解锁
#!desc=解锁 Duolingo Max 会员（Anywhere 原生重写版，纯 body 覆写，无脚本依赖）
#!author=Takagivegeta / adapted for Anywhere

[MITM]
# Duolingo - Anywhere MITM RuleSet
# 上游: TAKAGIVEGETA/MyScripts

name = Duolingo
hostname = ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn

# ── 格式说明（对照 Goodbility 的 Anywhere 写法）────────────────────────
# 一行一条重写规则，逗号分隔：
#   字段1 = 接口类型，0 = Anywhere 通用 HTTP 重写
#   字段2 = 动作，2 = 覆写响应 body
#   字段3 = URL 正则
#   字段4 = 后续参数个数（body 计数 + 可选 header 计数）
#   字段5 = 替换后的响应体 JSON
#
# ⚠ 注意：Duolingo 的解锁数据是按用户身份 + 时间动态生成的
#   （purchaseDate / expectedExpiration 依赖当前时间戳），所以：
#     A. 静态覆写 = 抄 Goodbility 写法，一次写好够用
#     B. 脚本覆写 = 动态生成时间戳，长期有效（推荐，见文末）
# ─────────────────────────────────────────────────────────────────────

[Rewrite]
# ── 方案 A：静态 body 覆写（仿 Goodbility 格式）──────────────────────
# expectedExpiration = 4102444800（2099-12-31），等效永久
0, 2, ^https?://(ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(n|om)/2023-05-23/users/[^/?#]+(?:[?#].*)?$, 2, "{""id"":1,""username"":""anywhere_user"",""subscriberLevel"":""GOLD"",""shopItems"":[{""id"":""gold_subscription"",""purchaseDate"":1740000000,""purchasePrice"":0,""subscriptionInfo"":{""expectedExpiration"":4102444800,""productId"":""com.duolingo.DuolingoMobile.subscription.Gold.TwelveMonth.24Q2Max.168"",""renewer"":""APPLE"",""renewing"":true,""tier"":""twelve_month"",""type"":""gold""}}],""trackingProperties"":{""has_item_immersive_subscription"":true,""has_item_premium_subscription"":true,""has_item_live_subscription"":true,""has_item_gold_subscription"":true,""has_item_max_subscription"":true},""Attention"":""Converted for Anywhere""}"

# ── 方案 B：脚本覆写（推荐，动态时间戳，长期有效）────────────────────
# 用 script-path 指向兼容脚本；把下面这行取消注释、并注释掉方案 A 那行
# http-response ^https?://(ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(n|om)/2023-05-23/(batch|users/[^/?#]+)(?:[?#].*)?$ script-response-body https://raw.githubusercontent.com/TAKAGIVEGETA/MyScripts/main/lingoDuo/lingoDuo-xaM.js
