# TalktoneDirect —— 由 sync_rules.py 生成，请改 loon/rule/TalktoneDirect.list，勿直接编辑。
# 出口 `cn_direct` 取自 sync_rules.py 的 HONK_OUTBOUND 表，组名见 honk/config.dae。
# 5 条 no-resolve 修饰符已丢弃：honk 没有逐条开关，解析行为由 dns 段统一决定。
routing {
    domain(
        suffix: agkn.com,
        suffix: cohere.com,
        suffix: crashlytics.com,
        suffix: inmobi.com,
        suffix: inner-active.mobi,
        suffix: ip-api.com,
        suffix: kochava.com,
        suffix: mobilefuse.com,
        suffix: talkatone.com
    ) -> cn_direct
    dip(
        205.164.56.0/24,
        216.172.154.0/24,
        50.117.27.0/24,
        63.251.124.0/24,
        69.46.75.0/24
    ) -> cn_direct
}
