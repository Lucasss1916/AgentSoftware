        full: meta-ohttp-relay-prod.fastly-edge.com,
        full: meta-ohttp-config-prod.fastly-edge.com,
        suffix: llama.com,
        suffix: llamameta.net,
        full: ai.developer.meta.com,
        full: ai.meta.com,
        full: aidemos.meta.com,
        full: developer.meta.com,
