        suffix: fbcdn.net,
        suffix: fbsbx.com,
        suffix: fbpigeon.com,
        suffix: fb.com,
        full: connect.facebook.net,
        suffix: instagram.com,
        suffix: cdninstagram.com,
        suffix: whatsapp.com,
        suffix: whatsapp.net
    ) -> ai
    dip(
        198.18.71.186/32,
        198.18.81.209/32,
        198.18.71.185/32,
        198.18.71.187/32,
        198.18.71.190/32,
        198.18.9.200/32,
