{
  "_notes": {
    "version": "1.0",
    "source": "由 clash/yaml/Overwrite.yaml 转换而来；rule-set 的 .mrs 链接已替换为 sing-box .srs 链接。",
    "country_group_filters": {
      "香港-智选":   "(?=.*(广港|香港|HK|Hong Kong|🇭🇰|HongKong)).*$",
      "台湾-智选":   "(?=.*(广台|台湾|台灣|TW|Tai Wan|🇹🇼|TaiWan|Taiwan)).*$",
      "日本-智选":   "(?=.*(广日|日本|JP|川日|东京|大阪|泉日|埼玉|沪日|深日|🇯🇵|Japan)).*$",
      "新加坡-智选": "(?=.*(广新|新加坡|SG|坡|狮城|🇸🇬|Singapore)).*$",
      "韩国-智选":   "(?=.*(广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea)).*$",
      "美国-智选":   "(?=.*(广美|美|US|纽约|波特兰|达拉斯|俄勒|凤凰城|费利蒙|拉斯|洛杉|圣何塞|圣克拉|西雅|芝加|🇺🇸|United States)).*$",
      "英国-智选":   "(?=.*(英国|英|伦敦|UK|United Kingdom|🇬🇧|London)).*$",
      "其他":        "排除上述所有国家关键字的兜底"
    },
    "how_to_fill_outbounds": [
      "1) 用 sub-store / sub-converter / mihomo-party 之类按上面 filter 正则把订阅节点过滤好",
      "2) 把过滤结果（节点 tag 列表）替换到下面每个 country urltest 的 outbounds 占位 'direct'",
      "3) 业务组（AIGC/GitHub/...）已经把所有 country urltest 当 outbounds 自动引用，无需再改"
    ],
    "dropped_rule_sets_vs_clash": [
      "TEST/Block/Meta AI/Copilot/Gemini/Proxy/Globe/Direct/Crunchyroll (liandu2024，无 sing-box 格式)",
      "Unity (LM-Firefly，无 sing-box 格式)",
      "如需启用，可用本仓的 convert_clash_to_singbox.py 把 .list 转成 JSON 后放进 singbox/rule/external/"
    ]
  },

  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "address": "https://1.1.1.1/dns-query",
        "address_resolver": "dns_resolver",
        "detour": "select"
      },
      {
        "tag": "dns_direct",
        "address": "https://223.5.5.5/dns-query",
        "address_resolver": "dns_resolver",
        "detour": "direct"
      },
      {
        "tag": "dns_resolver",
        "address": "223.5.5.5",
        "detour": "direct"
      },
      {
        "tag": "dns_fakeip",
        "address": "fakeip"
      },
      {
        "tag": "dns_block",
        "address": "rcode://success"
      }
    ],
    "rules": [
      { "outbound": "any", "server": "dns_resolver" },
      { "domain_suffix": [".lan", ".local"], "server": "dns_direct" },
      { "domain_keyword": ["time.", "ntp."], "server": "dns_direct" },
      { "domain_suffix": ["market.xiaomi.com", "weixin.qq.com", "qpic.cn", "qq.com"], "server": "dns_direct" },
      { "domain": ["localhost.ptlogin2.qq.com"], "server": "dns_direct" },
      { "rule_set": ["geosite-private", "geosite-cn", "direct-domain", "talktone-direct", "steam-cdn"], "server": "dns_direct" },
      { "rule_set": "talktone-ads", "server": "dns_block" },
      { "query_type": ["A", "AAAA"], "server": "dns_fakeip" }
    ],
    "fakeip": {
      "enabled": true,
      "inet4_range": "198.18.0.0/15"
    },
    "independent_cache": true,
    "strategy": "ipv4_only",
    "final": "dns_proxy"
  },

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "utun",
      "address": ["172.19.0.1/30"],
      "mtu": 9000,
      "auto_route": false,
      "auto_redirect": false,
      "strict_route": false,
      "stack": "gvisor",
      "endpoint_independent_nat": true,
      "sniff": true,
      "sniff_override_destination": true
